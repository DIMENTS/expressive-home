{
  "id": "app.expressive.home",
  "version": "1.5.0",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Expressive Home",
    "nl": "Expressive Home"
  },
  "description": {
    "en": "A beautiful dashboard for your tablet, laptop and phone",
    "nl": "Een mooi dashboard voor je tablet, laptop en telefoon"
  },
  "tags": {
    "en": ["dashboard", "tablet", "wall", "panel", "screen"],
    "nl": ["dashboard", "tablet", "muur", "paneel", "scherm"]
  },
  "category": "tools",
  "permissions": [
    "homey:manager:api"
  ],
  "brandColor": "#3B6939",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "DIMENTS"
  },
  "flow": {
    "triggers": [
      {
        "id": "dashboard_button",
        "title": {
          "en": "A dashboard button was pressed",
          "nl": "Er is op een dashboardknop gedrukt"
        },
        "titleFormatted": {
          "en": "Dashboard button [[button]] was pressed",
          "nl": "Er is op de dashboardknop [[button]] gedrukt"
        },
        "hint": {
          "en": "Choose a name for the button. It appears on the dashboard by itself, with the other flows. Every flow with the same name starts.",
          "nl": "Kies een naam voor de knop. Hij verschijnt vanzelf op het dashboard, bij de andere flows. Elke flow met dezelfde naam start."
        },
        "args": [
          {
            "type": "text",
            "name": "button",
            "title": {
              "en": "Name of the button",
              "nl": "Naam van de knop"
            },
            "placeholder": {
              "en": "Watch a film",
              "nl": "Film kijken"
            }
          }
        ],
        "tokens": [
          {
            "name": "device",
            "type": "string",
            "title": {
              "en": "Device with the dashboard",
              "nl": "Apparaat met het dashboard"
            },
            "example": {
              "en": "Kitchen tablet",
              "nl": "Tablet in de keuken"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "night_on",
        "title": {
          "en": "Switch the wall tablets to night",
          "nl": "Zet de wandtablets op nacht"
        }
      },
      {
        "id": "night_off",
        "title": {
          "en": "End the night on the wall tablets",
          "nl": "Haal de wandtablets uit de nacht"
        }
      },
      {
        "id": "theme_set",
        "title": {
          "en": "Set the theme of the house",
          "nl": "Zet het thema van het huis"
        },
        "titleFormatted": {
          "en": "Set the theme of the house to [[theme]]",
          "nl": "Zet het thema van het huis op [[theme]]"
        },
        "hint": {
          "en": "Every dashboard that follows the house changes at once. A theme of its own on a dashboard stays.",
          "nl": "Elk dashboard dat het huis volgt, verandert meteen. Een eigen thema van een dashboard blijft."
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "theme",
            "title": {
              "en": "Theme",
              "nl": "Thema"
            },
            "placeholder": {
              "en": "Glass",
              "nl": "Glas"
            }
          }
        ]
      },
      {
        "id": "mode_set",
        "title": {
          "en": "Set light or dark for the house",
          "nl": "Zet licht of donker voor het huis"
        },
        "titleFormatted": {
          "en": "Set the house to [[mode]]",
          "nl": "Zet het huis op [[mode]]"
        },
        "hint": {
          "en": "For every dashboard that follows the house in light or dark.",
          "nl": "Voor elk dashboard dat het huis volgt in licht of donker."
        },
        "args": [
          {
            "type": "dropdown",
            "name": "mode",
            "title": {
              "en": "Light or dark",
              "nl": "Licht of donker"
            },
            "values": [
              { "id": "light", "title": { "en": "light", "nl": "licht" } },
              { "id": "dark", "title": { "en": "dark", "nl": "donker" } },
              { "id": "auto", "title": { "en": "automatic", "nl": "automatisch" } }
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "getState": {
      "method": "GET",
      "path": "/state"
    },
    "getCode": {
      "method": "POST",
      "path": "/code"
    },
    "setRole": {
      "method": "PUT",
      "path": "/devices/:id"
    },
    "removeDevice": {
      "method": "DELETE",
      "path": "/devices/:id"
    },
    "setFlowKey": {
      "method": "POST",
      "path": "/flow-key"
    },
    "removeFlowKey": {
      "method": "DELETE",
      "path": "/flow-key"
    },
    "resetLooks": {
      "method": "POST",
      "path": "/looks/reset"
    },
    "setRecording": {
      "method": "PUT",
      "path": "/recording"
    },
    "wipeRecording": {
      "method": "DELETE",
      "path": "/recording"
    },
    "sync": {
      "method": "POST",
      "path": "/sync",
      "public": true
    }
  }
}
