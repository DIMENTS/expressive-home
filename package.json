{
  "name": "expressive-home",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && vite preview --open",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "vendor": "node tools/fetch-vendor.mjs",
    "fixture": "node tools/anonymize.mjs local/momentopname.raw.json src/mock/fixtures/camper.raw.json",
    "smoke": "npm run build && playwright test",
    "smoke:homey": "npm run homey-app && playwright test -c playwright.homey.config.ts",
    "app-store": "node tools/app-store.mjs",
    "store-images": "node tools/store-images.mjs",
    "readme-images": "node tools/readme-images.mjs",
    "homey-app": "tsc --noEmit && vite build -c vite.homey.config.ts && vite build -c vite.server.config.ts",
    "perf": "tsc --noEmit && vite build --outDir dist-perf --emptyOutDir && playwright test -c playwright.perf.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "5.3.2",
    "@material-symbols/svg-400": "0.49.0",
    "@material/material-color-utilities": "0.4.0",
    "lit": "3.3.3"
  }
}
